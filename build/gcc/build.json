{
    "schema_version": 1,
    "tools": {
        "cmake": "cmake",
        "ninja": "ninja",
        "arm_gcc": "arm-none-eabi-gcc"
    },
    "commands": {
        "configure": [
            "{python}",
            "{backend}/driver.py",
            "configure"
        ],
        "build": [
            "{python}",
            "{backend}/driver.py",
            "build"
        ],
        "clean": [
            "{python}",
            "{backend}/driver.py",
            "clean"
        ],
        "rebuild": [
            "{python}",
            "{backend}/driver.py",
            "rebuild"
        ],
        "size": [
            "{python}",
            "{backend}/driver.py",
            "size"
        ]
    }
}
