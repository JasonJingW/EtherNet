# Final build policy belongs to the root repository, not the component repos.
# The chip header is the single source of physical memory capacities.
set(_chip_config "${ETHERNET_PROJECT_ROOT}/platform_common/core/stm32f7xx/config/stm32f767xgx_config.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_chip_config}")
file(READ "${_chip_config}" _chip_text)
foreach(_region FLASH SRAM1 SRAM2 DTCM ITCM BACKUP_SRAM)
    if(NOT _chip_text MATCHES "#[ \t]*define[ \t]+CHIP_${_region}_SIZE_BYTES[ \t]+([0-9]+)[Uu]?[ \t]*[\r\n]")
        message(FATAL_ERROR "CHIP_${_region}_SIZE_BYTES must be a decimal byte literal in ${_chip_config}")
    endif()
    set(CHIP_${_region}_SIZE_BYTES "${CMAKE_MATCH_1}")
endforeach()

option(GCC_ENABLE_FREERTOS "Build FreeRTOS and application task management" ON)
option(GCC_ENABLE_RTT "Build SEGGER RTT and enable its logging backend" ON)
set(GCC_HEARTBEAT "AUTO" CACHE STRING "Heartbeat: AUTO enables with FreeRTOS, or force ON/OFF")
set_property(CACHE GCC_HEARTBEAT PROPERTY STRINGS AUTO ON OFF)
set(GCC_TIMERS "AUTO" CACHE STRING "Software timers: AUTO enables with FreeRTOS, or force ON/OFF")
set_property(CACHE GCC_TIMERS PROPERTY STRINGS AUTO ON OFF)
set(GCC_FREERTOS_PORT "CM7_R0P1" CACHE STRING "GCC FreeRTOS port")
set_property(CACHE GCC_FREERTOS_PORT PROPERTY STRINGS CM7_R0P1 CM4F)
set(GCC_MAIN_STACK_SIZE "4096" CACHE STRING "Interrupt/main stack reservation in DTCM (bytes)")
option(GCC_WARNINGS_AS_ERRORS "Treat C compiler warnings as errors" ON)

if(GCC_HEARTBEAT STREQUAL "AUTO")
    if(GCC_ENABLE_FREERTOS)
        set(GCC_WITH_HEARTBEAT ON)
    else()
        set(GCC_WITH_HEARTBEAT OFF)
    endif()
elseif(GCC_HEARTBEAT STREQUAL "ON" OR GCC_HEARTBEAT STREQUAL "OFF")
    set(GCC_WITH_HEARTBEAT "${GCC_HEARTBEAT}")
else()
    message(FATAL_ERROR "GCC_HEARTBEAT must be AUTO, ON or OFF")
endif()
if(GCC_WITH_HEARTBEAT AND NOT GCC_ENABLE_FREERTOS)
    message(FATAL_ERROR "Heartbeat requires FreeRTOS. Use GCC_HEARTBEAT=OFF/AUTO for a bare-metal build.")
endif()
if(GCC_TIMERS STREQUAL "AUTO")
    if(GCC_ENABLE_FREERTOS)
        set(GCC_WITH_TIMERS ON)
    else()
        set(GCC_WITH_TIMERS OFF)
    endif()
elseif(GCC_TIMERS STREQUAL "ON" OR GCC_TIMERS STREQUAL "OFF")
    set(GCC_WITH_TIMERS "${GCC_TIMERS}")
else()
    message(FATAL_ERROR "GCC_TIMERS must be AUTO, ON or OFF")
endif()
if(GCC_WITH_TIMERS AND NOT GCC_ENABLE_FREERTOS)
    message(FATAL_ERROR "Software timers require FreeRTOS. Use GCC_TIMERS=OFF/AUTO for bare metal.")
endif()
if(NOT GCC_FREERTOS_PORT MATCHES "^(CM7_R0P1|CM4F)$")
    message(FATAL_ERROR "GCC_FREERTOS_PORT must be CM7_R0P1 or CM4F")
endif()
if(NOT GCC_MAIN_STACK_SIZE MATCHES "^[0-9]+$")
    message(FATAL_ERROR "GCC_MAIN_STACK_SIZE must be an integer byte count")
endif()
math(EXPR _gcc_stack_remainder "${GCC_MAIN_STACK_SIZE} % 8")
if(GCC_MAIN_STACK_SIZE LESS 256 OR GCC_MAIN_STACK_SIZE GREATER CHIP_DTCM_SIZE_BYTES
        OR NOT _gcc_stack_remainder EQUAL 0)
    message(FATAL_ERROR "Main stack must be 8-byte aligned, at least 256 bytes and fit DTCM")
endif()
